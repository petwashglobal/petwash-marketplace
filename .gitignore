node_modules
# dist - REMOVED: Must be included in Cloud Run deployments (built before deploy)
# But: dist/**/*.map source maps publish full server+client source to anyone
# who reads dist/public/. Block them at .gitignore so future builds do not
# regress. Vite's `sourcemap: 'hidden'` mode still EMITS .map files; this
# rule prevents them from being added back to git.
# Build output — produced fresh by CI (deploy + Firebase jobs both run
# `npm run build` before consuming it); committed copies were pure churn.
dist/
.DS_Store
server/public
vite.config.ts.*
*.tar.gz

# GCS Backup System
gcs-service-account.json
petwash-backup-*.tar.gz
firestore-restore/
.env
# Temporary setup files
setup-github.js
# Logs
*.log
npm-debug.log*
# Editor
.vscode/
.idea/
# Database
*.sqlite
*.sqlite3
# Cache
.cache/
tmp/
# Large test/benchmark files (exceed GitHub 100MB limit)
load-test-results.json
*.results.json
*-results.json
# Private keys — never commit
*.key
*.pem
petwash-wallet.key
# Service-account / credential JSON keys — never commit (caused secret-scanning leak #8)
*service-account*.json
*serviceaccount*.json
*-credentials.json
attached_assets/*.json
*.pkpass
*.pkpasses
# Secrets files — never commit
*.secrets*.txt
.secrets-for-nir-only.txt
# Session / auth artifacts — never commit
cookies.txt
test_cookies.txt
*_cookies.txt
tmp_login.txt
temp_response.txt
# Build / scan logs — never commit
build-output.txt
load-test-output.txt

# PR-STARTUP-HARDEN-1 — smoke-test artifacts (regenerated per CI run; uploaded to GH artifacts instead)
/smoke-test-output/

# Apple/Play signing secrets — never commit. The ASC .p8 lives encrypted on
# EAS servers (uploaded via `eas credentials`), never in the repo. (PetWash 2026-06-11)
*.p8
mobile-app/*.p8
mobile-app/play-store-service-account.json
