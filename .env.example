# ==================== PetWash™ Ltd - Environment Configuration ====================
# Copy this file to .env and fill in your actual values
# NEVER commit .env to version control!

# ==================== Firebase Configuration ====================
VITE_FIREBASE_API_KEY=your-firebase-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=signinpetwash.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=signinpetwash
VITE_FIREBASE_STORAGE_BUCKET=signinpetwash.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=your-firebase-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# ==================== ReCAPTCHA (for forms, not Firebase App Check) ====================
# Get from: https://www.google.com/recaptcha/admin
VITE_RECAPTCHA_SITE_KEY=your-recaptcha-v3-site-key-here
# Server-side secret key for verifying reCAPTCHA tokens (REQUIRED for walker registration)
# Get from: https://www.google.com/recaptcha/admin → your site → Settings → Secret Key
RECAPTCHA_SECRET_KEY=your-recaptcha-v3-secret-key-here

# ==================== Firebase App Check (Optional - Production Only) ====================
# Get from: Firebase Console > Project Settings > App Check
# If not set, App Check is disabled (fail-open mode)
VITE_FIREBASE_APPCHECK_SITE_KEY=your-appcheck-site-key-here

# ==================== WebAuthn / Passkey Configuration ====================
# Production domain for passkeys (e.g., petwash.co.il)
VITE_WEBAUTHN_RP_ID=petwash.co.il

# ==================== Google Cloud Services ====================
# For backup system, translation, vision API
GOOGLE_APPLICATION_CREDENTIALS=./gcs-service-account.json
GOOGLE_TRANSLATE_API_KEY=your-google-translate-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# ==================== Google Business & Gmail ====================
GOOGLE_BUSINESS_CLIENT_ID=your-google-business-client-id
GOOGLE_BUSINESS_CLIENT_SECRET=your-google-business-client-secret
GOOGLE_BUSINESS_REFRESH_TOKEN=your-google-business-refresh-token
GOOGLE_BUSINESS_ACCOUNT_ID=your-google-business-account-id
GMAIL_CLIENT_ID=your-gmail-client-id
GMAIL_CLIENT_SECRET=your-gmail-client-secret
GMAIL_REFRESH_TOKEN=your-gmail-refresh-token
GMAIL_TOKEN_ENCRYPTION_KEY=your-32-char-encryption-key

# ==================== Gemini AI ====================
GEMINI_API_KEY=your-gemini-api-key-here

# ==================== Twilio (SMS & Verification) ====================
# Required in production — startup will abort if any of these are missing/malformed.
TWILIO_ACCOUNT_SID=your-twilio-account-sid        # Format: AC followed by 32 hex chars
TWILIO_AUTH_TOKEN=your-twilio-auth-token          # 32 lowercase hex chars
TWILIO_PHONE_NUMBER=+1234567890                   # E.164 format. Either this OR TWILIO_MESSAGING_SERVICE_SID must be set.
TWILIO_MESSAGING_SERVICE_SID=your-twilio-messaging-service-sid  # Optional — use instead of TWILIO_PHONE_NUMBER for branded sender
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886        # Optional — WhatsApp sender number in "whatsapp:+<E164>" format
TWILIO_WHATSAPP_CONTENT_SID=                      # Optional — approved WhatsApp template SID

# ==================== SendGrid (Email) ====================
# Required in production — startup will abort if SENDGRID_API_KEY is missing.
SENDGRID_API_KEY=your-sendgrid-api-key            # Format: SG. followed by key (create at app.sendgrid.com)
SENDGRID_FROM_EMAIL=noreply@petwash.co.il         # Verified sender address in SendGrid
SENDGRID_FROM_NAME=PetWash                        # Display name for outgoing email
SENDGRID_WEBHOOK_VERIFICATION_KEY=your-sendgrid-webhook-verification-key  # From SendGrid → Settings → Mail Settings → Event Webhook

# ==================== HubSpot CRM ====================
HUBSPOT_PORTAL_ID=your-hubspot-portal-id
HUBSPOT_FORM_GUID=your-hubspot-form-guid

# ==================== TikTok Integration ====================
TIKTOK_CLIENT_KEY=your-tiktok-client-key
TIKTOK_CLIENT_SECRET=your-tiktok-client-secret

# ==================== Sentry (Error Tracking) ====================
SENTRY_DSN=your-sentry-dsn-url

# ==================== Slack (Alerts) ====================
ALERTS_SLACK_WEBHOOK=your-slack-webhook-url

# ==================== Security & Encryption ====================
KYC_SALT=your-random-salt-for-kyc-hashing
VOUCHER_SALT=your-random-salt-for-voucher-codes
MOBILE_LINK_SECRET=your-mobile-link-secret-key
# HMAC-SHA256 salt for IP hashing in login_security_events. Required in production.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
IP_HASH_SALT=your-random-64-hex-ip-hash-salt

# ==================== Nayax Payment Gateway ====================
NAYAX_API_KEY=your-nayax-api-key
NAYAX_SECRET=your-nayax-secret
NAYAX_BASE_URL=https://api.nayax.com
NAYAX_MERCHANT_ID=your-merchant-id
NAYAX_TERMINAL_ID=your-terminal-id
NAYAX_WEBHOOK_SECRET=your-webhook-secret
NAYAX_MERCHANT_FEE_RATE=0.029

# ==================== Provider Bank Payout (Israeli Bank Transfer) ====================
# Set to "true" ONLY when real Israeli bank API is wired in ProviderPayoutService.
# When false (default), payouts are queued as pending_transfer — no actual bank transfer occurs.
# NEVER set to true until: bank credentials are configured + processIsraeliBankTransfer() is implemented.
BANK_PAYOUT_LIVE=false

# ==================== Tranzila Payment Gateway (Digital Purchase Flows) ====================
# Architecture: Tranzila handles e-gift, wallet top-up, marketplace bookings.
# K9000 card sale stays on Nayax. K9000 member redeem stays on internal ledger.
# Migration order (safest first): e-gift → wallet top-up → marketplace bookings
# NEVER enable TRANZILA_MARKETPLACE_ENABLED before e-gift and wallet top-up are stable in prod.
TRANZILA_TERMINAL_NAME=your-tranzila-terminal-name
TRANZILA_TERMINAL_PASSWORD=your-tranzila-terminal-password
TRANZILA_WEBHOOK_SECRET=your-tranzila-webhook-secret
TRANZILA_EGIFT_ENABLED=false
TRANZILA_WALLET_TOPUP_ENABLED=false
TRANZILA_MARKETPLACE_ENABLED=false

# ==================== Application Settings ====================
BASE_URL=https://petwash.co.il
PAYMENTS_PROVIDER=nayax
VAT_RATE=0.17
METRICS_AUTH_TOKEN=your-metrics-auth-token

# ==================== Security / Session Secrets (REQUIRED in production) ====================
# Randomly generated secret for signing social OAuth session cookies.
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex')"
COOKIE_SECRET=your-random-64-char-hex-string-here

# Comma-separated list of admin EMAIL addresses (lowercase) that bypass
# all role checks and gate access to the Operations Brain (/admin/brain),
# trust/ranking admin endpoints, and the requireAdmin middleware.
#
# - Lowercase only. Comma-separated. No spaces around commas.
# - Match exactly to the email Firebase Auth sees on each user's token.
# - Set this in Cloud Run env vars in production. Do NOT commit the real
#   production list to source. .env.example exists for format only.
# - If unset in production: all super-admin email routes return 403
#   (fail-closed). Operations Brain dashboard becomes unreachable.
#
# Production format (set in Cloud Run, not here):
#   SUPER_ADMIN_EMAILS=ceo@example.com,cfo@example.com,ops@example.com
SUPER_ADMIN_EMAILS=your-admin-email@example.com

# Single Firebase UID for super-admin trust/ranking admin routes.
# If not set in production, those routes will return 403 (fail-safe).
SUPER_ADMIN_UID=your-firebase-uid-here

# Email address authorised to APPROVE staff / admin / management access
# requests via POST /api/admin/approve-access. If unset in production,
# only super-admins (SUPER_ADMIN_EMAILS) can approve staff. Without
# either, staff approval calls return 403 silently.
# Format: a single email address.
ADMIN_APPROVER_EMAIL=approver@petwash.co.il

# Encryption key for provider documents (required — server aborts without it in production).
# Generate with: node -e "require('crypto').randomBytes(32).toString('hex')"
DOCUMENT_ENCRYPTION_KEY=your-random-64-char-hex-string-here

# ==================== Email Reports ====================
REPORTS_EMAIL_TO=reports@petwash.co.il
REPORTS_EMAIL_CC=admin@petwash.co.il

# ==================== Public App URL ====================
# Used in booking confirmation links (emails, SMS), Nayax success/cancel
# return URLs, and Google Calendar event descriptions. Must include the
# protocol; do NOT include a trailing slash. Production example:
#   APP_URL=https://petwash.co.il
APP_URL=https://petwash.co.il

# ==================== Google Calendar Integration ====================
# Used by server/services/CalendarIntegrationService.ts to create / delete
# Google Calendar events when bookings are accepted or cancelled.
#
# In production (Cloud Run): set GOOGLE_SERVICE_ACCOUNT_JSON to the FULL
# service-account JSON (single-line, properly escaped). The service
# account must have the "Google Calendar API" scope, and the target
# calendar must be shared with the service-account email.
#
# Either env var works (the service tries them in this order):
#   GOOGLE_SERVICE_ACCOUNT_JSON          — preferred for Cloud Run
#   GOOGLE_APPLICATION_CREDENTIALS_JSON  — fallback
#   FIREBASE_SERVICE_ACCOUNT_KEY         — last resort (also used for FCM)
#
# If none of these are set, the calendar service silently no-ops (logs
# a warning, returns null). The booking flow continues — calendar sync
# is best-effort and never blocks a booking.
#
# In development on Replit: leave these unset and use the Replit
# "google-calendar" connector instead (auto-detected via
# REPLIT_CONNECTORS_HOSTNAME + REPL_IDENTITY).
#
# Optional: target a specific calendar instead of the service-account's
# primary calendar. Default = 'primary'.
# GOOGLE_CALENDAR_ID=primary
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# ==================== Database (Auto-configured by Replit) ====================
# These are automatically set by Replit, no need to configure manually
# DATABASE_URL=postgresql://...
# PGHOST=...
# PGPORT=...
# PGUSER=...
# PGPASSWORD=...
# PGDATABASE=...

# ==================== Redis (Optional - for caching) ====================
# If not set, uses in-memory fallback
# REDIS_URL=redis://...

# ==================== Integration Testing (NEVER expose in production) ====================
# Set TEST_BYPASS_TOKEN only in dev/test environments. Must match the value on the server.
# TEST_BYPASS_TOKEN=some-random-secret-for-test-only
#
# JWT_SECRET_TEST: a SEPARATE JWT signing key used only by integration tests.
# The server already reads this in generateTestToken() when NODE_ENV != production.
# NEVER set this to the same value as JWT_SECRET.
# JWT_SECRET_TEST=another-random-secret-for-test-only
