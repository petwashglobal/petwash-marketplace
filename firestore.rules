rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Admin check uses Firebase custom claims — no hardcoded emails
    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.role == 'admin' ||
        request.auth.token.role == 'super_admin' ||
        request.auth.token.admin == true
      );
    }
    
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }
    
    function isProvider() {
      return isAuthenticated() && request.auth.token.role == 'provider';
    }
    
    function isStaff() {
      return isAuthenticated() && (
        request.auth.token.role == 'staff' ||
        request.auth.token.role == 'ops' ||
        request.auth.token.accountType == 'internal'
      );
    }
    
    // App Check helper — graceful degradation when App Check not configured
    function isAppCheckVerified() {
      return request.app != null;
    }
    
    // Employee helpers based on Firestore profile (legacy path)
    function getEmployeeProfile() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid)/employee/profile;
      return exists(path) ? get(path).data : null;
    }
    
    function isActiveEmployee() {
      let profile = getEmployeeProfile();
      return isAuthenticated() && profile != null && profile.status == 'active';
    }
    
    function hasActiveRole(role) {
      let profile = getEmployeeProfile();
      return isAuthenticated() && profile != null && profile.status == 'active' && profile.role == role;
    }
    
    function isActiveAdminEmployee() {
      return hasActiveRole('admin');
    }
    
    function isActiveOpsEmployee() {
      return hasActiveRole('ops');
    }
    
    // ============================================
    // USER PROFILES
    // ============================================
    match /users/{userId} {
      allow read: if isAuthenticated() && (isOwner(userId) || isAdmin() || isStaff());
      allow write: if isAuthenticated() && isOwner(userId);
      allow create: if isAuthenticated() && isOwner(userId);
      
      // Employee profiles — role-based access control
      match /employee/profile {
        allow read: if isAuthenticated() && (
          (isActiveEmployee() && isOwner(userId)) ||
          isAdmin() ||
          isActiveAdminEmployee() ||
          isActiveOpsEmployee()
        );
        allow create: if isAdmin() || isActiveAdminEmployee();
        allow update: if isAdmin() || isActiveAdminEmployee() ||
          (isActiveEmployee() && isOwner(userId) && 
           request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt']));
        allow delete: if isAdmin() || isActiveAdminEmployee();
      }
      
      // Pet profiles — owner reads/writes their own pets
      match /pets/{petId} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow write: if isAuthenticated() && isOwner(userId);
        allow delete: if isAuthenticated() && isOwner(userId);
      }
      
      // User profile data subcollection
      match /profile/{doc} {
        allow read: if isAuthenticated() && (isOwner(userId) || isAdmin());
        allow write: if isAuthenticated() && isOwner(userId);
      }
    }
    
    // ============================================
    // EMPLOYEES COLLECTION (new flat path)
    // ============================================
    match /employees/{uid} {
      allow read: if isAuthenticated() && (
        isOwner(uid) || isAdmin() || isActiveAdminEmployee() || isActiveOpsEmployee()
      );
      allow create: if isAdmin() || isActiveAdminEmployee();
      allow update: if isAdmin() || isActiveAdminEmployee() ||
        (isActiveEmployee() && isOwner(uid) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLoginAt']));
      allow delete: if isAdmin() || isActiveAdminEmployee();
    }
    
    // ============================================
    // PET PROFILES (top-level collection)
    // ============================================
    match /pets/{petId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.uid || isAdmin()
      );
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.uid;
      allow update: if isAuthenticated() && request.auth.uid == resource.data.uid;
      allow delete: if isAuthenticated() && (request.auth.uid == resource.data.uid || isAdmin());
    }
    
    // ============================================
    // KYC DOCUMENTS
    // ============================================
    match /kyc/{kycId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if isAuthenticated() && request.auth.uid == request.resource.data.userId;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // VOUCHERS & BIRTHDAY VOUCHERS
    // ============================================
    match /birthday_vouchers/{voucherId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    match /vouchers/{voucherId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.issuedToUid || isAdmin()
      );
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // BOOKINGS
    // ============================================
    match /bookings/{bookingId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.customerId ||
        request.auth.uid == resource.data.providerId ||
        isAdmin()
      );
      // Creator must be the customer (userId/customerId must match auth UID)
      allow create: if isAuthenticated() && (
        request.auth.uid == request.resource.data.userId ||
        request.auth.uid == request.resource.data.customerId
      );
      // Only booking parties or admin may update; status transitions are validated server-side
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.userId ||
        request.auth.uid == resource.data.customerId ||
        request.auth.uid == resource.data.providerId ||
        isAdmin()
      );
      allow delete: if isAdmin();
    }
    
    // ============================================
    // CONVERSATIONS & MESSAGES
    // ============================================
    match /conversations/{conversationId} {
      allow read: if isAuthenticated() && (
        request.auth.uid in resource.data.participants || isAdmin()
      );
      // Creator must be a participant in the conversation
      allow create: if isAuthenticated() &&
        request.auth.uid in request.resource.data.participants;
      allow update: if isAuthenticated() && (
        request.auth.uid in resource.data.participants || isAdmin()
      );
      allow delete: if isAdmin();
      
      match /messages/{messageId} {
        allow read: if isAuthenticated() && (
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants || isAdmin()
        );
        // Message sender must be a participant in the conversation
        allow create: if isAuthenticated() &&
          request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.participants;
        allow update: if isAdmin();
        allow delete: if isAdmin();
      }
    }
    
    // ============================================
    // FCM TOKENS (push notifications)
    // ============================================
    match /fcmTokens/{userId}/devices/{deviceId} {
      allow read: if isAuthenticated() && isOwner(userId);
      allow write: if isAuthenticated() && isOwner(userId);
      allow delete: if isAuthenticated() && isOwner(userId);
    }
    
    // ============================================
    // PERFORMANCE METRICS (RUM) — admin-read only; authenticated write (rate-limited server-side)
    // ============================================
    match /performance_metrics/{metricId} {
      allow read: if isAdmin();
      // Only non-sensitive metrics fields; no PII allowed here
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['page', 'metric', 'value', 'timestamp', 'sessionId', 'platform']);
    }
    
    // ============================================
    // ANALYTICS & SYSTEM LOGS (admin-write only via server; create allowed for telemetry)
    // ============================================
    match /analytics_events/{eventId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated() &&
        request.resource.data.keys().hasOnly(['event', 'timestamp', 'sessionId', 'platform', 'userId', 'metadata']);
    }
    
    match /system_logs/{logId} {
      allow read: if isAdmin();
      // System logs are written by server only via Admin SDK; client writes denied
      allow create: if false;
    }
    
    // ============================================
    // CRM
    // ============================================
    match /crm_email_templates/{templateId} {
      allow read: if isAuthenticated() && (isAdmin() || isStaff());
      allow write: if isAdmin();
    }
    
    match /crm_communications/{commId} {
      allow read: if isAdmin() || isStaff();
      allow write: if isAdmin();
    }
    
    match /adminLogs/{logId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
    
    match /alerts/{alertId} {
      allow read: if isAdmin() || isStaff();
      allow write: if isAdmin();
    }
    
    // ============================================
    // TRANSACTIONS
    // ============================================
    match /transactions/{transactionId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if isAuthenticated() && 
                      request.auth.uid == request.resource.data.userId;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // STATIONS
    // ============================================
    match /stations/{stationId} {
      allow read: if isAdmin() || isStaff() || (isAuthenticated() && request.auth.token.role == 'owner');
      allow write: if isAdmin();
      
      match /inventory/{sku} {
        allow read: if isAdmin() || isStaff() || (isAuthenticated() && request.auth.token.role == 'owner');
        allow write: if isAdmin();
      }
    }
    
    match /station_events/{eventId} {
      allow read: if isAdmin() || isStaff() || (isAuthenticated() && request.auth.token.role == 'owner');
      allow write: if isAdmin();
    }
    
    match /station_alerts/{alertId} {
      allow read: if isAdmin() || isStaff() || (isAuthenticated() && request.auth.token.role == 'owner');
      allow write: if isAdmin();
    }
    
    match /station_usage_daily/{docId} {
      allow read: if isAdmin() || isStaff();
      allow write: if isAdmin();
    }
    
    match /reconciliation_daily/{docId} {
      allow read: if isAdmin() || isStaff();
      allow write: if isAdmin();
    }
    
    match /station_inventory/{stationId} {
      allow read: if isAdmin() || isStaff();
      allow write: if isAdmin();
    }
    
    // ============================================
    // SYSTEM BACKUPS
    // ============================================
    match /system_backups/{backupId} {
      allow read: if isAdmin();
      allow write: if false;
      allow delete: if isAdmin();
      
      match /collections/{collectionDoc} {
        allow read: if isAdmin();
        allow write: if false;
        allow delete: if isAdmin();
      }
    }
    
    // ============================================
    // ENTERPRISE: FRANCHISE
    // ============================================
    match /franchises/{franchiseId} {
      allow read, update: if isAdmin();
      allow read, update: if isAuthenticated() && 
                            request.auth.token.role == 'owner' && 
                            request.auth.token.franchise_id == franchiseId;
      allow create, delete: if isAdmin();
    }
    
    match /inventory/{franchiseId} {
      allow read, write: if isAuthenticated() && request.auth.token.franchise_id == franchiseId;
    }
    
    match /inventory/{franchiseId}/items/{itemId} {
      allow read, write: if isAuthenticated() && request.auth.token.franchise_id == franchiseId;
    }
    
    match /projects/{projectId} {
      allow read: if isAdmin();
      allow read: if isAuthenticated() && 
                    request.auth.token.departments != null && 
                    projectId in request.auth.token.departments;
      allow update: if isAuthenticated() && request.auth.token.manager_id == request.auth.uid;
      allow create, delete: if isAdmin();
    }
    
    // ============================================
    // ENTERPRISE: INBOX & MESSAGING
    // ============================================
    match /inboxes/{staffUid}/messages/{messageId} {
      allow read, write: if isAuthenticated() && request.auth.uid == staffUid;
      allow write: if isAdmin();
    }
    
    // ============================================
    // ENTERPRISE: FINANCIAL DATA
    // ============================================
    match /invoices/{invoiceId} {
      allow read, write: if isAdmin() || 
                           (isAuthenticated() && request.auth.token.role == 'finance');
    }
    
    match /bank_transactions/{transactionId} {
      allow read, write: if isAdmin() || 
                           (isAuthenticated() && request.auth.token.role == 'finance');
    }
    
    match /expenses/{expenseId} {
      allow read: if isAdmin() || 
                    (isAuthenticated() && resource.data.franchiseId == request.auth.token.franchise_id);
      allow write: if isAdmin() || 
                     (isAuthenticated() && request.resource.data.franchiseId == request.auth.token.franchise_id);
    }
    
    match /receipts_raw/{receiptId} {
      allow read: if isAdmin() || 
                    (isAuthenticated() && resource.data.franchiseId == request.auth.token.franchise_id);
      allow create: if isAuthenticated() && 
                      request.resource.data.franchiseId == request.auth.token.franchise_id &&
                      request.auth.token.franchise_id != null;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // ENTERPRISE: COMPLIANCE & SECURITY
    // ============================================
    match /dpo_appointments/{dpoId} {
      allow read, write: if isAdmin();
    }
    
    match /penetration_tests/{testId} {
      allow read, write: if isAdmin();
    }
    
    match /security_incidents/{incidentId} {
      allow read, write: if isAdmin();
    }
    
    // ============================================
    // GOOGLE WALLET / PASSES
    // ============================================
    match /google_wallet_passes/{passId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // MARKETING ASSETS
    // ============================================
    match /marketingAssets/{assetId} {
      allow read: if isAuthenticated() && (isAdmin() || isStaff());
      allow write: if isAdmin();
    }
    
    match /serviceTickets/{franchiseId}/{ticketId} {
      allow read: if isAuthenticated() && (
        request.auth.token.franchise_id == franchiseId || isAdmin()
      );
      allow write: if isAdmin() || 
                     (isAuthenticated() && request.auth.token.franchise_id == franchiseId);
    }
    
    match /observances/{locale} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ============================================
    // APPLE WALLET PASSES
    // ============================================
    match /apple_wallet_passes/{passId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if isAdmin();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /wallet_device_registrations/{regId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
    }

    match /wallet_telemetry/{docId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================
    // LOYALTY
    // ============================================
    match /loyalty_members/{memberId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin() || isStaff()
      );
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /loyalty_transactions/{txId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /referrals/{referralId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.referrerId ||
        request.auth.uid == resource.data.referredId ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================
    // PROVIDER PROFILES
    // ============================================
    match /sitter_profiles/{profileId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isProvider();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /walker_profiles/{profileId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isProvider();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow delete: if isAdmin();
    }

    match /pettrek_drivers/{driverId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && isProvider();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow delete: if isAdmin();
    }

    // ============================================
    // MARKETPLACE
    // ============================================
    match /marketplace_listings/{listingId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && (isProvider() || isAdmin());
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.sellerId || isAdmin()
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.sellerId || isAdmin()
      );
    }

    match /escrow_payments/{escrowId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.buyerId ||
        request.auth.uid == resource.data.sellerId ||
        isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ============================================
    // NOTIFICATIONS
    // ============================================
    match /notifications/{notifId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if isAuthenticated() || isAdmin();
      allow update: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow delete: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
    }

    // ============================================
    // SECURITY & COMPLIANCE (admin/staff only)
    // ============================================
    match /fraud_detection_logs/{logId} {
      allow read: if isAdmin() || isStaff();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /compliance_monitoring/{docId} {
      allow read: if isAdmin() || isStaff();
      allow write: if isAdmin();
    }

    match /ai_feature_requests/{reqId} {
      allow read: if isAuthenticated() && (
        request.auth.uid == resource.data.userId || isAdmin()
      );
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /security_updates/{updateId} {
      allow read: if isAdmin() || isStaff();
      allow write: if isAdmin();
    }

    // ============================================
    // STATION HEARTBEATS
    // ============================================
    match /station_heartbeats/{heartbeatId} {
      allow read: if isAdmin() || isStaff();
      allow create: if isAuthenticated();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }
    
    // ============================================
    // DEFAULT DENY ALL OTHER COLLECTIONS
    // ============================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
