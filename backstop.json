{
  "id": "petwash_responsive_qa",
  "viewports": [
    {
      "label": "xs_portrait",
      "width": 375,
      "height": 667
    },
    {
      "label": "xs_landscape",
      "width": 667,
      "height": 375
    },
    {
      "label": "sm_portrait",
      "width": 640,
      "height": 1136
    },
    {
      "label": "sm_landscape",
      "width": 1136,
      "height": 640
    },
    {
      "label": "md_portrait",
      "width": 768,
      "height": 1024
    },
    {
      "label": "md_landscape",
      "width": 1024,
      "height": 768
    },
    {
      "label": "lg_portrait",
      "width": 1024,
      "height": 1366
    },
    {
      "label": "lg_landscape",
      "width": 1366,
      "height": 1024
    },
    {
      "label": "xl_portrait",
      "width": 1440,
      "height": 900
    },
    {
      "label": "xl_landscape",
      "width": 1920,
      "height": 1080
    },
    {
      "label": "xxl_desktop",
      "width": 1920,
      "height": 1080
    },
    {
      "label": "xxxl_ultrawide",
      "width": 2560,
      "height": 1440
    }
  ],
  "onBeforeScript": "puppet/onBefore.js",
  "onReadyScript": "puppet/onReady.js",
  "scenarios": [
    {
      "label": "Homepage (Landing)",
      "cookiePath": "backstop_data/engine_scripts/cookies.json",
      "url": "http://localhost:5000/",
      "referenceUrl": "",
      "readyEvent": "",
      "readySelector": "",
      "delay": 3000,
      "hideSelectors": [],
      "removeSelectors": [],
      "hoverSelector": "",
      "clickSelector": "",
      "postInteractionWait": 0,
      "selectors": [],
      "selectorExpansion": true,
      "expect": 0,
      "misMatchThreshold": 0.1,
      "requireSameDimensions": true
    },
    {
      "label": "Header Navigation",
      "url": "http://localhost:5000/",
      "delay": 2000,
      "selectors": ["header", ".hamburger-right"],
      "misMatchThreshold": 0.1
    },
    {
      "label": "Mobile Menu (Open)",
      "url": "http://localhost:5000/",
      "delay": 2000,
      "clickSelector": ".hamburger-right",
      "postInteractionWait": 1000,
      "selectors": ["[role='dialog']"],
      "misMatchThreshold": 0.1
    },
    {
      "label": "Wallet Page",
      "url": "http://localhost:5000/wallet",
      "delay": 3000,
      "misMatchThreshold": 0.1
    },
    {
      "label": "SignIn Page",
      "url": "http://localhost:5000/signin",
      "delay": 2000,
      "misMatchThreshold": 0.1
    },
    {
      "label": "Franchise Page",
      "url": "http://localhost:5000/franchise",
      "delay": 3000,
      "misMatchThreshold": 0.1
    },
    {
      "label": "K9000 Overview",
      "url": "http://localhost:5000/k9000/overview",
      "delay": 2000,
      "misMatchThreshold": 0.1
    },
    {
      "label": "Sitter Suite Overview",
      "url": "http://localhost:5000/sitter-suite/overview",
      "delay": 2000,
      "misMatchThreshold": 0.1
    },
    {
      "label": "Walk My Pet Overview",
      "url": "http://localhost:5000/walk-my-pet/overview",
      "delay": 2000,
      "misMatchThreshold": 0.1
    }
  ],
  "paths": {
    "bitmaps_reference": "backstop_data/bitmaps_reference",
    "bitmaps_test": "backstop_data/bitmaps_test",
    "engine_scripts": "backstop_data/engine_scripts",
    "html_report": "backstop_data/html_report",
    "ci_report": "backstop_data/ci_report"
  },
  "report": ["browser", "CI"],
  "engine": "puppeteer",
  "engineOptions": {
    "args": ["--no-sandbox", "--disable-setuid-sandbox", "--disable-dev-shm-usage"]
  },
  "asyncCaptureLimit": 5,
  "asyncCompareLimit": 50,
  "debug": false,
  "debugWindow": false
}
