# .dockerignore — PetWash Cloud Run build exclusions
#
# ARCHITECTURE NOTE: dist/ is pre-built by CI (npm run build with VITE_* secrets)
# before docker build runs. dist/ MUST be in the build context so the runner stage
# can COPY --from=builder /app/dist. Do NOT add dist here.
#
node_modules
.git
.github
npm-debug.log
.env
.env.*
.replit
replit.nix
replit.md
.local
tmp
coverage
attached_assets
