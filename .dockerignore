# Deployment Optimization - Exclude unnecessary files from Docker build context
# Multi-stage build handles the rest - this just speeds up COPY . .

# BIGGEST savings: attached_assets (stock images, screenshots, etc.)
attached_assets/

# Git history not needed
.git/
.gitignore
.gitattributes

# Development dependencies cache
node_modules/.cache
.npm
.yarn

# Test files and coverage
*.test.ts
*.test.tsx
*.spec.ts
*.spec.tsx
__tests__
coverage
.nyc_output
vitest.config.ts
playwright.config.ts
test-*.ts

# Development tools
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# Documentation
*.md
!README.md
docs/
examples/

# Build artifacts from previous builds
build
.vite
.cache

# Environment files
.env.local
.env.development
.env.test

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Temporary files
tmp/
temp/
*.tmp

# Source maps (dev only)
*.map

# TypeScript cache
*.tsbuildinfo

# Development scripts
scripts/dev-*
scripts/test-*

# Large media files (use CDN in production)
public/dev-*

# Backup files
*.bak
*.backup

# Database dumps (not needed in deployment)
*.sql
*.dump

# Certificate files (use secrets instead)
*.pem
*.key
*.cert

# Service account files (use environment variables)
*-service-account.json
gcs-service-account.json

# Development configuration
.replit
replit.nix
.local/
.config/

# Standalone scripts not needed at runtime
analyze_id.ts
verify_id_temp.ts
send_launch_invitation.ts
POSTMAN_COLLECTION.json
