modules = ["nodejs-20", "web", "python-3.11", "postgresql-16"]

run = ["npm", "run", "dev"]
build = ["npm", "run", "build"]

hidden = [".config", ".git", "generated-icon.png", "node_modules"]

[nix]
channel = "stable-24_05"
packages = ["dig", "freetype", "git-lfs", "imagemagick", "jq", "k6", "lcms2", "libimagequant", "libjpeg", "libtiff", "libwebp", "libxcrypt", "openjpeg", "openssl", "optipng", "pngquant", "psmisc", "tcl", "tk", "zlib", "yakut", "google-cloud-sdk-gce"]

[deployment]
deploymentTarget = "cloudrun"
build = ["npm", "run", "build"]
run = ["npm", "run", "start"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "NODE_OPTIONS='--max-old-space-size=4096' npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[agent]
integrations = ["javascript_database:1.0.0", "javascript_auth_all_persistence:1.0.0", "firebase_barebones_javascript:1.0.0", "javascript_log_in_with_replit:1.0.0", "hubspot:1.0.0", "javascript_gemini_ai_integrations:1.0.0", "google-mail:1.0.0", "google-sheet:1.0.0", "google-calendar:1.0.0", "github:1.0.0", "spotify:1.0.0", "sendgrid:1.0.0"]

[userenv]

[userenv.shared]
# Set all of these in Replit Secrets (Tools → Secrets) — never hardcode real values here.
# See docs/SECRETS_PLACEHOLDERS.md for the full list and where to obtain each value.
VITE_PRODUCTION_API_URL = "https://YOUR_REPLIT_DEV_URL.replit.dev"
GOOGLE_FORMS_SPREADSHEET_ID = "YOUR_GOOGLE_FORMS_SPREADSHEET_ID"
ACCOUNTING_SPREADSHEET_ID = "YOUR_ACCOUNTING_SPREADSHEET_ID"
FIREBASE_PROJECT_ID = "YOUR_FIREBASE_PROJECT_ID"
TWILIO_ACCOUNT_SID = "YOUR_TWILIO_ACCOUNT_SID"
TWILIO_MESSAGING_SERVICE_SID = "YOUR_TWILIO_MESSAGING_SERVICE_SID"
VITE_TURNSTILE_SITE_KEY = "YOUR_CLOUDFLARE_TURNSTILE_SITE_KEY"
SUPER_ADMIN_EMAILS = "admin@yourdomain.com"
VITE_FIREBASE_APPCHECK_SITE_KEY = "YOUR_RECAPTCHA_ENTERPRISE_SITE_KEY"
SUPER_ADMIN_ALERT_PHONE = "+COUNTRY_CODE_AND_NUMBER"
ADMIN_APPROVER_EMAIL = "admin@yourdomain.com"
SUPER_ADMIN_UID = "YOUR_FIREBASE_SUPER_ADMIN_UID"
FINANCE_AUTHORIZED_EMAILS = "finance@yourdomain.com"

[userenv.development]
DEV_TEST_SECRET = "YOUR_DEV_TEST_SECRET"

[userenv.production]
NODE_ENV = "production"

[[ports]]
localPort = 5000
externalPort = 5000

[[ports]]
localPort = 23636
externalPort = 80

[[ports]]
localPort = 23637
externalPort = 3001
