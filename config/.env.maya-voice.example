# =============================================================================
# Maya Voice — environment variables (Stage 3A through 3E)
# Copy these into your production .env (Cloud Run env, Vault, etc.).
# DO NOT commit real keys to git.
# =============================================================================

# ---------- Master flags (also flippable from SystemConfig DB store) ----------
# These can live in .env OR in SystemConfig. SystemConfig wins if both are set.
# Defaults are OFF — production stays dormant until you flip them.
# ff.maya.enabled=false
# ff.maya.voice.enabled=false
# ff.maya.voice.inbound.enabled=false
# ff.maya.voice.outbound.enabled=false
# ff.maya.voice.extraction.enabled=false
# ff.maya.voice.recording.enabled=false

# ---------- Twilio (Stage 3B) ----------
# From Twilio console → Account → API keys & tokens.
TWILIO_AUTH_TOKEN=

# Full public URL Twilio reaches the webhook at. If unset, derived from
# X-Forwarded-Proto + Host + originalUrl (works on Cloud Run with proxy).
# Set this explicitly to avoid signature mismatches behind unusual proxy setups.
TWILIO_VOICE_PUBLIC_URL=https://api.petwash.co.il/api/maya/voice/twilio/voice

# ---------- LLM provider (Stage 3C) ----------
# 'anthropic' (default), 'openai', or 'stub' for tests.
MAYA_LLM_PROVIDER=anthropic

# Default model — Claude Haiku for low-latency phone turns.
# MAYA_LLM_MODEL=claude-haiku-4-5

# Max tokens per turn. Phone turns are short; 200 is plenty.
# MAYA_LLM_MAX_TOKENS=200

# Required if MAYA_LLM_PROVIDER=anthropic.
ANTHROPIC_API_KEY=

# Required if MAYA_LLM_PROVIDER=openai.
# OPENAI_API_KEY=

# ---------- Knowledge file path (Stage 3C) ----------
# Optional absolute path override. Default: <repo>/config/maya-knowledge.json
# MAYA_KNOWLEDGE_PATH=/var/petwash/maya-knowledge.json
